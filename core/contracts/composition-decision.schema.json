{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/composition-decision.schema.json",
  "title": "CompositionDecision Contract",
  "description": "OD-15: a composition decision binds multiple executors under a declared policy. Composition never aggregates authority: the authority ceiling stays the WorkUnit ceiling and each participant carries its own routing decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "policy_ref", "mode", "participants", "authority_aggregation", "authority_ceiling_ref", "created_at"],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^cd_[a-z0-9_]+$" },
    "policy_ref": { "type": "string", "minLength": 1 },
    "mode": { "$ref": "maws-vnext-common.schema.json#/$defs/compositionMode" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executor_id", "routing_decision_ref"],
        "properties": {
          "executor_id": { "$ref": "maws-vnext-common.schema.json#/$defs/executorId" },
          "routing_decision_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority_aggregation": { "const": "none" },
    "authority_ceiling_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
