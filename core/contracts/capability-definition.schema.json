{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/capability-definition.schema.json",
  "title": "CapabilityDefinition Contract",
  "description": "OD-01: a capability names a bounded execution competency with its minimum execution-profile dimension requirements. A capability is never authority and never a model identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "description", "dimension_requirements"],
  "properties": {
    "capability_id": { "$ref": "maws-vnext-common.schema.json#/$defs/capabilityId" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "dimension_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "effects", "context", "network", "delegation", "verification"],
      "properties": {
        "tools": { "$ref": "maws-vnext-common.schema.json#/$defs/toolsLevel" },
        "effects": { "$ref": "maws-vnext-common.schema.json#/$defs/effectsLevel" },
        "context": { "$ref": "maws-vnext-common.schema.json#/$defs/contextLevel" },
        "network": { "$ref": "maws-vnext-common.schema.json#/$defs/networkLevel" },
        "delegation": { "$ref": "maws-vnext-common.schema.json#/$defs/delegationDepth" },
        "verification": { "$ref": "maws-vnext-common.schema.json#/$defs/verificationLevel" }
      }
    }
  }
}
