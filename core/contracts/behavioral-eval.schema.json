{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BehavioralEvalRecord Contract",
  "description": "Baseline/candidate behavioral evaluation record for the skill-effectiveness eval family (MAWS-SII-TARGET-SPEC-001 v0.2.0, slice S5). One record captures one isolated model-run pass over one corpus variant: routing quality, output quality, security regression gate, and cost/latency signals, bound to reproducibility digests. The record is analysis output: it gates release quality for the evaluated subject but grants no permission, promotes no skill, activates no runtime, and replaces no approval decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_id",
    "created_at",
    "variant",
    "subject",
    "model_run",
    "case_families",
    "metrics",
    "security_gate",
    "verdict",
    "reproducibility",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "eval_id": {
      "type": "string",
      "pattern": "^bev_[a-z0-9_]+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "variant": {
      "enum": ["BASELINE", "CANDIDATE"]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["skill", "instruction_set", "routing_profile", "harness"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "instruction_revision": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of the exact subject content the evaluation measured. For a skill subject this is the sha256 of the skill file bytes the corpus carried and the runner verified at evaluation time; a record that measured a skill without this binding cannot prove what it measured."
        }
      }
    },
    "model_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "isolated", "executor_ref", "isolation_envelope"],
      "properties": {
        "mode": {
          "enum": ["recorded_replay", "live_model"]
        },
        "isolated": {
          "type": "boolean",
          "description": "true only when the runner enforced the isolation envelope itself. recorded_replay enforces it by construction (no process runs at all). A live_model run through an uncontained in-process executor must declare isolated false with workspace_write uncontained_process; such a record stays recordable evidence but can never carry verdict IMPROVEMENT_PROVEN (semantic rule R6)."
        },
        "executor_ref": {
          "type": "string",
          "minLength": 1
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "isolation_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspace_write", "network", "inherited_qualification", "allowed_effects"],
          "properties": {
            "workspace_write": {
              "enum": ["none", "temp_dir_only", "uncontained_process"]
            },
            "network": {
              "enum": ["deny", "allowlisted"]
            },
            "inherited_qualification": {
              "enum": ["none"]
            },
            "allowed_effects": {
              "const": []
            }
          }
        }
      }
    },
    "case_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/caseFamilyResult"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing", "output", "cost", "latency"],
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions_expected", "decisions_matched"],
          "properties": {
            "decisions_expected": {
              "type": "integer",
              "minimum": 0
            },
            "decisions_matched": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assertions_total", "assertions_passed"],
          "properties": {
            "assertions_total": {
              "type": "integer",
              "minimum": 0
            },
            "assertions_passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens_in", "tokens_out", "cost_units"],
          "properties": {
            "tokens_in": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_out": {
              "type": "integer",
              "minimum": 0
            },
            "cost_units": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latency_ms_max"],
          "properties": {
            "latency_ms_max": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "security_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_cases_total", "security_regressions", "gate"],
      "properties": {
        "security_cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "security_regressions": {
          "type": "integer",
          "minimum": 0
        },
        "gate": {
          "enum": ["PASS", "BLOCK"]
        }
      }
    },
    "verdict": {
      "enum": ["BASELINE_RECORDED", "IMPROVEMENT_PROVEN", "IMPROVEMENT_REJECTED", "BLOCKED"]
    },
    "baseline_ref": {
      "type": "string",
      "pattern": "^bev_[a-z0-9_]+$"
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_eval_id", "routing_accuracy_delta", "output_assertion_pass_delta", "security_regressions"],
      "properties": {
        "baseline_eval_id": {
          "type": "string",
          "pattern": "^bev_[a-z0-9_]+$"
        },
        "routing_accuracy_delta": {
          "type": "number"
        },
        "output_assertion_pass_delta": {
          "type": "number"
        },
        "security_regressions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_ref", "corpus_digest", "runner", "content_digest"],
      "properties": {
        "corpus_ref": {
          "type": "string",
          "minLength": 1
        },
        "corpus_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "required": ["kind", "ref", "content_digest"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_run": {
            "properties": {
              "mode": {
                "const": "recorded_replay"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model_run": {
            "properties": {
              "isolated": {
                "const": true
              },
              "isolation_envelope": {
                "properties": {
                  "workspace_write": {
                    "enum": ["none", "temp_dir_only"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_run": {
            "properties": {
              "isolated": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "model_run": {
            "properties": {
              "isolation_envelope": {
                "properties": {
                  "workspace_write": {
                    "const": "uncontained_process"
                  }
                }
              }
            }
          },
          "verdict": {
            "enum": ["BASELINE_RECORDED", "IMPROVEMENT_REJECTED", "BLOCKED"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "BASELINE"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": ["BASELINE_RECORDED", "BLOCKED"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "CANDIDATE"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": ["IMPROVEMENT_PROVEN", "IMPROVEMENT_REJECTED", "BLOCKED"]
          },
          "baseline_ref": {
            "type": "string",
            "pattern": "^bev_[a-z0-9_]+$"
          }
        },
        "required": ["baseline_ref"]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": ["IMPROVEMENT_PROVEN", "IMPROVEMENT_REJECTED"]
          }
        }
      },
      "then": {
        "required": ["comparison"]
      },
      "else": {
        "not": {
          "required": ["comparison"]
        }
      }
    }
  ],
  "$defs": {
    "caseFamilyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "blocking", "corpus_digest", "cases_total", "cases_passed", "cases_failed"],
      "properties": {
        "family": {
          "enum": ["positive", "negative", "security_regression", "model_parity"]
        },
        "blocking": {
          "type": "boolean"
        },
        "corpus_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "cases_total": {
          "type": "integer",
          "minimum": 1
        },
        "cases_passed": {
          "type": "integer",
          "minimum": 0
        },
        "cases_failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
