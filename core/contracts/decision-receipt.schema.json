{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/decision-receipt.schema.json",
  "title": "Jev DecisionReceipt Contract",
  "description": "OD-18: every Jev decision produces a receipt recording the typed question, the deterministic candidate set, the selected answer, confidence, requested model alias, and the model version resolved by TypeSafe. Receipts never contain secrets or full state, and answers outside the provided choice set are invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "question_id", "choices", "answer", "confidence",
    "requested_model", "resolved_model", "decision_contract_version",
    "threshold_policy_version", "mode", "created_at"
  ],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^jevr_[a-z0-9_]+$" },
    "question_id": { "type": "string", "minLength": 1 },
    "choices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "answer": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requested_model": { "type": "string", "minLength": 1 },
    "resolved_model": { "type": "string", "minLength": 1 },
    "decision_contract_version": { "type": "string", "minLength": 1 },
    "threshold_policy_version": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["fixture", "live", "openrouter"] },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
