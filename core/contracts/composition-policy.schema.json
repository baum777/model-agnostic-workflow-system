{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/composition-policy.schema.json",
  "title": "CompositionPolicy Contract",
  "description": "OD-15: the workflow declares whether multi-executor composition is allowed, which modes, and count/parallelism/budget bounds. The planner selects bindings only inside these constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "allowed_modes", "max_executors", "max_parallelism", "workload_safety_classes_allowed"],
  "properties": {
    "policy_id": { "type": "string", "pattern": "^comp_[a-z0-9_]+$" },
    "allowed_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "maws-vnext-common.schema.json#/$defs/compositionMode" }
    },
    "max_executors": { "type": "integer", "minimum": 1, "maximum": 8 },
    "max_parallelism": { "type": "integer", "minimum": 1, "maximum": 8 },
    "max_total_cost_units": { "type": "number", "minimum": 0 },
    "workload_safety_classes_allowed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "maws-vnext-common.schema.json#/$defs/workloadSafetyClass" }
    }
  }
}
