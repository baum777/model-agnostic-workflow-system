{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/materiality-decision.schema.json",
  "title": "MaterialityDecision Contract",
  "description": "OD-12: configuration deltas between the qualified fingerprint and the current fingerprint are classified per component. overall_class NON_MATERIAL requires every delta NON_MATERIAL; MATERIAL and UNKNOWN are unroutable without requalification (fail closed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id", "qualified_fingerprint_ref", "current_fingerprint_ref",
    "deltas", "overall_class", "decided_at"
  ],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^mat_[a-z0-9_]+$" },
    "qualified_fingerprint_ref": { "type": "string", "minLength": 1 },
    "current_fingerprint_ref": { "type": "string", "minLength": 1 },
    "deltas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "from", "to", "classification"],
        "properties": {
          "component": {
            "enum": ["model_id", "provider_id", "runtime_harness", "tool_contract_refs", "api_surface_version", "qualification_profile_ref", "execution_profile_ref"]
          },
          "from": true,
          "to": true,
          "classification": { "$ref": "maws-vnext-common.schema.json#/$defs/materialityClass" }
        }
      }
    },
    "overall_class": { "$ref": "maws-vnext-common.schema.json#/$defs/materialityClass" },
    "decided_at": { "type": "string", "minLength": 1 },
    "evidence_refs": { "$ref": "maws-vnext-common.schema.json#/$defs/stringRefs" }
  },
  "allOf": [
    {
      "if": { "properties": { "overall_class": { "const": "NON_MATERIAL" } }, "required": ["overall_class"] },
      "then": {
        "properties": {
          "deltas": {
            "items": {
              "properties": { "classification": { "const": "NON_MATERIAL" } },
              "required": ["classification"]
            }
          }
        }
      }
    }
  ]
}
