{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/skill-promotion-adoption.schema.json",
  "title": "SkillPromotionAdoptionRecord Contract",
  "description": "S8 (spec MAWS-SII-TARGET-SPEC-001 v0.2.0, PROPOSED): canonical record of one owner-governed skill promotion. The record binds the whole promotion chain: the skill frontdoor admission (mandatory complement of behavioral evidence, never replaced by it) bound to the EXACT candidate identity and content that is adopted, the S5 behavioral eval evidence bound by content digest, subject and corpus and age, the canonical owner approval bound to the approved candidate digest, the versioned canonical adoption (the adopted version strictly greater than the superseded version READ FROM THE CANONICAL TREE, the adoption digest over the whole bound chain, and an append-only adoption ledger that makes the applied change reconstructable and replay-protected), the export regeneration state, and the post-adoption readback. authority_granted is false by construction: Feedback != Rule, Proposal != Applied Change, Eval PASS != Authority, Approval != Permission -- the adoption changes canonical skill content and never grants permission, qualification, or runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adoption_id", "candidate", "frontdoor_admission",
    "eval_evidence", "owner_approval", "canonical_adoption",
    "export_regeneration", "post_adoption_readback", "authority_granted",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "adoption_id": { "type": "string", "pattern": "^adopt_[a-z0-9_]+$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "adopted_version", "candidate_digest", "screened_digest"],
      "properties": {
        "skill_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "adopted_version": { "$ref": "#/$defs/semver" },
        "candidate_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "screened_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "frontdoor_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_ref", "admission_digest", "implementation_disposition", "screened_digest"],
      "properties": {
        "record_ref": { "type": "string", "minLength": 1 },
        "admission_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "implementation_disposition": { "const": "ELIGIBLE" },
        "screened_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "eval_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavioral_eval_records", "improvement_proven", "corpus_digest", "max_evidence_age_days"],
      "properties": {
        "behavioral_eval_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_ref", "content_digest", "verdict", "subject_ref", "corpus_digest", "created_at"],
            "properties": {
              "record_ref": { "type": "string", "minLength": 1 },
              "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "verdict": { "enum": ["BASELINE_RECORDED", "IMPROVEMENT_PROVEN", "IMPROVEMENT_REJECTED", "BLOCKED"] },
              "subject_ref": { "type": "string", "minLength": 1 },
              "corpus_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "created_at": { "type": "string", "minLength": 1 }
            }
          }
        },
        "improvement_proven": { "type": "boolean" },
        "corpus_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "max_evidence_age_days": { "type": "integer", "minimum": 1 }
      }
    },
    "owner_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "skill_id", "decision_ref", "approved_at", "candidate_digest", "authority_id", "key_id", "signature_verified", "approval_record_ref", "approval_record_digest"],
      "properties": {
        "approver": { "const": "canonical_owner" },
        "skill_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "decision_ref": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "minLength": 1 },
        "candidate_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "authority_id": { "const": "canonical_owner", "description": "The trust anchor the approval was verified against." },
        "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "signature_verified": { "const": true, "description": "The approval signature verified against the published canonical owner key. A self-declared approver or decision reference is not representable here." },
        "approval_record_ref": { "type": "string", "pattern": "^core/authority/approvals/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$" },
        "approval_record_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "canonical_adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "superseded_version", "superseded_version_source", "adoption_digest", "adopted_at", "adoption_ledger_ref"],
      "properties": {
        "canonical_path": { "type": "string", "pattern": "^skills/[a-z0-9][a-z0-9._-]*/SKILL\\.md$" },
        "superseded_version": { "$ref": "#/$defs/semver" },
        "superseded_version_source": { "enum": ["canonical_skill_file", "no_prior_canonical_version"] },
        "adoption_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "adopted_at": { "type": "string", "minLength": 1 },
        "adoption_ledger_ref": { "type": "string", "pattern": "^skills/[a-z0-9][a-z0-9._-]*/ADOPTIONS\\.jsonl$" }
      }
    },
    "export_regeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "generator_version", "registry_version", "adoption_digest", "export_digests", "regenerated_at", "readback_verified"],
      "properties": {
        "performed": { "const": true, "description": "A canonical adoption always regenerates the canonical registry and provider exports. A promotion that did not regenerate them is not representable." },
        "generator_version": { "type": "string", "minLength": 1 },
        "registry_version": { "type": ["string", "null"] },
        "adoption_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$", "description": "The exports are bound to the adoption they were regenerated for." },
        "export_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "digest", "bytes"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "regenerated_at": { "type": "string", "minLength": 1 },
        "readback_verified": { "const": true }
      }
    },
    "post_adoption_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "readback_digest_match", "readback_at"],
      "properties": {
        "performed": { "const": true },
        "readback_digest_match": { "const": true },
        "readback_at": { "type": "string", "minLength": 1 }
      }
    },
    "authority_granted": { "const": false },
    "created_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
