{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/execution-profile.schema.json",
  "title": "ExecutionProfile Contract",
  "description": "OD-10/OD-11: qualification is scoped to a capability under a fully dimensioned execution profile. Profiles carry all six dimensions explicitly; there is no global scalar broader/stricter shortcut.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "description", "dimensions"],
  "properties": {
    "profile_id": { "$ref": "maws-vnext-common.schema.json#/$defs/profileId" },
    "description": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "effects", "context", "network", "delegation", "verification"],
      "properties": {
        "tools": { "$ref": "maws-vnext-common.schema.json#/$defs/toolsLevel" },
        "effects": { "$ref": "maws-vnext-common.schema.json#/$defs/effectsLevel" },
        "context": { "$ref": "maws-vnext-common.schema.json#/$defs/contextLevel" },
        "network": { "$ref": "maws-vnext-common.schema.json#/$defs/networkLevel" },
        "delegation": { "$ref": "maws-vnext-common.schema.json#/$defs/delegationDepth" },
        "verification": { "$ref": "maws-vnext-common.schema.json#/$defs/verificationLevel" }
      }
    }
  }
}
