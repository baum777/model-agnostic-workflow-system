{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/candidate-graph.schema.json",
  "title": "CandidateGraph Contract",
  "description": "OD-02: planner output before binding. A candidate graph proposes structure only; nodes carry no executor binding. Binding requires deterministic validation (all mandatory stages present) and produces a BoundExecutionGraph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "template_ref", "root_work_unit_id", "nodes", "validation"],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^cand_[a-z0-9_]+$" },
    "template_ref": { "type": "string", "minLength": 1 },
    "root_work_unit_id": { "$ref": "maws-vnext-common.schema.json#/$defs/workUnitId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "work_unit_id", "stage", "depends_on", "status"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^node_[a-z0-9_]+$" },
          "work_unit_id": { "$ref": "maws-vnext-common.schema.json#/$defs/workUnitId" },
          "stage": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "pattern": "^node_[a-z0-9_]+$" },
            "uniqueItems": true
          },
          "status": { "const": "candidate" }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "result"],
      "properties": {
        "checked": { "type": "boolean" },
        "result": { "enum": ["pending", "passed", "failed"] },
        "issues": { "$ref": "maws-vnext-common.schema.json#/$defs/stringRefs" }
      }
    }
  }
}
