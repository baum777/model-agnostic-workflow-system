{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/plan-revision-decision.schema.json",
  "title": "PlanRevisionDecision Contract",
  "description": "OD-07: every revision decision records base and active graph versions plus an explicit revalidation result. A non-STILL_VALID revalidation can never yield ACCEPTED; stale requests require explicit revalidation, never silent rebase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "request_ref", "base_graph_version", "active_graph_version", "revalidation", "outcome", "new_graph_version", "supersession_ref", "decided_at"],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^rdec_[a-z0-9_]+$" },
    "request_ref": { "type": "string", "minLength": 1 },
    "base_graph_version": { "type": "integer", "minimum": 1 },
    "active_graph_version": { "type": "integer", "minimum": 1 },
    "revalidation": { "$ref": "maws-vnext-common.schema.json#/$defs/revalidationResult" },
    "outcome": { "enum": ["ACCEPTED", "REJECTED", "STALE"] },
    "new_graph_version": { "type": ["null", "integer"], "minimum": 1 },
    "supersession_ref": { "type": ["null", "string"], "minLength": 1 },
    "decided_at": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "revalidation": { "enum": ["CONFLICTING", "OBSOLETE", "REQUIRES_REBASE"] } }, "required": ["revalidation"] },
      "then": { "properties": { "outcome": { "enum": ["REJECTED", "STALE"] } } }
    },
    {
      "if": { "properties": { "outcome": { "const": "ACCEPTED" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "revalidation": { "const": "STILL_VALID" },
          "new_graph_version": { "type": "integer", "minimum": 1 },
          "supersession_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
