{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core/contracts/rollback-record.schema.json",
  "title": "RollbackPlanRecord Contract",
  "description": "S9 (spec MAWS-SII-TARGET-SPEC-001 v0.2.0, slice S9 Regression and Rollback): one CONTROLLED ROLLBACK PLAN of a failed candidate to the LAST QUALIFIED revision of the same subject. The record states a PLAN, not an execution: the restore target is the newest revision whose qualification is QUALIFIED and evidence-backed - not an arbitrary older revision - the materiality of the restored state against the qualification it would inherit is re-derived, so a restore that does not actually restore the qualified state fails closed, and the execution history is carried through unchanged, proven by an evidence-inventory digest that was taken BEFORE the rollback and is never derived from the state it checks (a missing digest is a refusal, not a default). The verdict is ROLLBACK_PLANNED, never ROLLED_BACK: a plan is not an apply, and a record of a PERFORMED restore with its post-write readback is a separate contract. The record adopts nothing, promotes nothing and grants no authority (`authority_granted` and `adoption_authorized` are const false).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rollback_id",
    "created_at",
    "subject",
    "rolled_back_from",
    "restored_to",
    "materiality_after_rollback",
    "history",
    "verdict",
    "refusal_code",
    "refusal_detail",
    "adoption_authorized",
    "authority_granted",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rollback_id": {
      "type": "string",
      "pattern": "^rbk_[a-z0-9_]+$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill",
            "instruction_set",
            "routing_profile",
            "harness"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rolled_back_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "restored_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "qualification_id",
        "qualification_state",
        "fingerprint_id"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "qualification_id": {
          "type": "string",
          "pattern": "^qual_[a-z0-9_]+$"
        },
        "qualification_state": {
          "enum": [
            "QUALIFIED",
            "NOT_QUALIFIED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "fingerprint_id": {
          "type": "string",
          "pattern": "^fp_[a-z0-9_]+$"
        }
      }
    },
    "materiality_after_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "overall_class",
        "deltas"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^mat_[a-z0-9_]+$"
        },
        "overall_class": {
          "enum": [
            "NON_MATERIAL",
            "MATERIAL",
            "UNKNOWN"
          ]
        },
        "deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "from",
              "to",
              "classification"
            ],
            "properties": {
              "component": {
                "enum": [
                  "model_id",
                  "provider_id",
                  "runtime_harness",
                  "tool_contract_refs",
                  "api_surface_version",
                  "qualification_profile_ref",
                  "execution_profile_ref",
                  "effective_instruction_digest"
                ]
              },
              "from": true,
              "to": true,
              "classification": {
                "enum": [
                  "NON_MATERIAL",
                  "MATERIAL",
                  "UNKNOWN"
                ]
              }
            }
          }
        }
      },
      "description": "The materiality decision re-derived for the restored state, comparing the qualification's fingerprint with the fingerprint of the state the restore would produce. Only NON_MATERIAL makes the inherited qualification routable; MATERIAL and UNKNOWN fail closed (spec section 11.3)."
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_digest",
        "entries",
        "digest_before",
        "digest_after",
        "unchanged"
      ],
      "properties": {
        "inventory_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "The digest of the evidence inventory as it stood BEFORE the rollback. It is independent evidence supplied by the caller."
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        },
        "digest_before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "The independent pre-rollback digest the current inventory is compared against. null when the caller supplied none, which is a refusal."
        },
        "digest_after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "The digest recomputed from the inventory as it stands now. null when the plan was refused before the comparison."
        },
        "unchanged": {
          "type": "boolean",
          "description": "true when the inventory as it stands now hashes to the independent pre-rollback digest: nothing of the history was lost. It is a statement about the current state, not a claim that a restore happened."
        }
      }
    },
    "verdict": {
      "enum": [
        "ROLLBACK_PLANNED",
        "BLOCKED"
      ]
    },
    "refusal_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "ROLLBACK_TARGET_NOT_QUALIFIED",
        "ROLLBACK_TARGET_NOT_LAST_QUALIFIED",
        "ROLLBACK_NOT_A_ROLLBACK",
        "HISTORY_NOT_PRESERVED",
        "HISTORY_DIGEST_MISSING",
        "MATERIALITY_NOT_NON_MATERIAL",
        "QUALIFICATION_EVIDENCE_MISSING",
        "FINGERPRINT_MISSING"
      ],
      "description": "null for a planned rollback, the typed refusal code for a blocked one. A blocked plan names why it was refused; it never names a restore that did not happen."
    },
    "refusal_detail": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "null for a planned rollback, the human-readable reason for a blocked one. The reason is part of the record, so a refusal is reconstructable without reading the run log."
    },
    "adoption_authorized": {
      "const": false
    },
    "authority_granted": {
      "const": false
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ROLLBACK_PLANNED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "refusal_code": {
            "type": "null"
          },
          "refusal_detail": {
            "type": "null"
          },
          "restored_to": {
            "properties": {
              "qualification_state": {
                "const": "QUALIFIED"
              }
            },
            "required": [
              "qualification_state"
            ]
          },
          "materiality_after_rollback": {
            "properties": {
              "overall_class": {
                "const": "NON_MATERIAL"
              }
            },
            "required": [
              "overall_class"
            ]
          },
          "history": {
            "properties": {
              "unchanged": {
                "const": true
              },
              "digest_before": {
                "type": "string"
              }
            },
            "required": [
              "unchanged",
              "digest_before"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "refusal_code": {
            "type": "string",
            "minLength": 1
          },
          "refusal_detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
